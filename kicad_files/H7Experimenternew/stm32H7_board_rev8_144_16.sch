<sheets>
<sheet>
<plain>
<text x="431.8" y="215.9" size="1.016" layer="91">lnj426W83RA - 10ma</text>
<text x="431.8" y="190.5" size="1.778" layer="91">actually 6.03V</text>
<text x="576.58" y="353.06" size="1.778" layer="91">SD_CARD</text>
<text x="637.54" y="78.74" size="2.54" layer="91">UUP1C220MCL1GS or EEE-1CA220NP</text>
<text x="703.58" y="393.7" size="1.778" layer="91">decoupling caps for SDRAM</text>
<text x="576.58" y="38.1" size="1.778" layer="91">COG</text>
<text x="574.04" y="10.16" size="1.778" layer="91">COG</text>
<text x="530.86" y="5.08" size="1.778" layer="91">COG</text>
<text x="530.86" y="40.64" size="1.778" layer="91">COG</text>
<text x="668.02" y="119.38" size="1.778" layer="91">COG</text>
<text x="675.64" y="93.98" size="1.778" layer="91">COG</text>
<text x="629.92" y="83.82" size="1.778" layer="91">COG</text>
<text x="629.92" y="121.92" size="1.778" layer="91">COG</text>
<text x="502.92" y="63.5" size="1.778" layer="91">seems like either OPA4376 or OPA4344 will work</text>
<text x="647.7" y="76.2" size="1.778" layer="91">are the bipolar capacitors</text>
<text x="579.12" y="276.86" size="0.8128" layer="91">to use as EXTIN to sync ADC with audio</text>
<text x="662.94" y="243.84" size="1.778" layer="91">0.05" SWD 10-pin</text>
</plain>
